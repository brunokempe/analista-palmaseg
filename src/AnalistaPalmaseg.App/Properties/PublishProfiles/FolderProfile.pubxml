<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>C:\Programas\Estágiaio Palma Seguros</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>

  <!--
    Assina automaticamente o .exe/DLLs publicados com o certificado self-signed do projeto,
    para evitar o bloqueio do Controle de Aplicativo Inteligente (Smart App Control) do Windows.
    Veja scripts\codesigning\README.md. Se o certificado ainda nao existir na maquina (thumbprint
    nao encontrado), o passo avisa e segue sem quebrar o publish.
  -->
  <Target Name="SignPublishedFiles" AfterTargets="Publish">
    <PropertyGroup>
      <CodeSigningScriptsDir>$(MSBuildThisFileDirectory)..\..\..\..\scripts\codesigning\</CodeSigningScriptsDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(CodeSigningScriptsDir)Sign-Publish.ps1&quot; -PublishDir &quot;$(PublishDir)&quot;"
          ContinueOnError="WarnAndContinue"
          Condition="Exists('$(CodeSigningScriptsDir)Sign-Publish.ps1')" />
  </Target>
</Project>