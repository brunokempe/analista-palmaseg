<UserControl x:Class="AnalistaPalmaseg.App.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="White">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource SidebarBgDarkBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,4">
                <Run Text="Bem-vindo(a)," />
                <Run Text="{Binding NomeUsuario, Mode=OneWay}" FontWeight="Bold" />
            </TextBlock>
            <TextBlock Text="Selecione uma seção no menu lateral para começar."
                       FontSize="13" Foreground="{StaticResource SidebarBgDarkBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
