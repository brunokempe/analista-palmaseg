<UserControl x:Class="AnalistaPalmaseg.App.Views.InicioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- Banner de boas-vindas -->
            <Border Background="{StaticResource SidebarBgDarkBrush}" Padding="36,28,36,28">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,4">
                        <Run Text="Bem-vindo(a)," />
                        <Run Text="{Binding NomeUsuario, Mode=OneWay}" FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock Text="Selecione uma seção no menu lateral para começar."
                               FontSize="13" Foreground="#9CA3AF" />
                </StackPanel>
            </Border>

            <!-- ── Linha 1: Acompanhamento de Renovações ── -->
            <Grid Margin="24,20,24,0">

                <!-- Acompanhamento de Renovações -->
                <materialDesign:Card Padding="20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource AccentTealBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="ACOMPANHAMENTO DE RENOVAÇÕES" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentTealBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding AcompARenovar}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="À renovar" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding AcompRenPalma}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" />
                                <TextBlock Text="Ren. Palma" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding AcompEmitido}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock Text="Emitido" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding AcompOutros}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Outros" FontSize="10"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="{Binding AcompTotal}" />
                            <Run Text=" registros no acompanhamento" />
                        </TextBlock>

                        <TextBlock Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding TemDadosRenovacoes, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                            Nenhum registro de renovação encontrado.
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

            </Grid>

            <!-- ── Linha 2: Dashboard de Emissão (largura total) ── -->
            <materialDesign:Card Margin="24,16,24,24" Padding="20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="DASHBOARD DE EMISSÃO — REN. PALMA" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <UniformGrid Columns="4">
                        <!-- Total Ren. Palma -->
                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="FileSign" Width="16" Height="16"
                                                         Foreground="{StaticResource AccentBlueBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Total Ren. Palma" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EmissaoTotal}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock Text="contratos fechados" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- Prêmio Total -->
                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="16" Height="16"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Prêmio Líquido Total" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EmissaoPremioTotal, StringFormat=C2}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="soma dos fechamentos" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- Assinaturas Pendentes -->
                        <StackPanel Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="FileEditOutline" Width="16" Height="16"
                                                         Foreground="{StaticResource WarningBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Assinaturas Pendentes" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EmissaoAssinaturasPendentes}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" />
                            <TextBlock Text="aguardando assinatura" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>

                        <!-- Emissões Pendentes -->
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="ShieldOff" Width="16" Height="16"
                                                         Foreground="{StaticResource DangerBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Emissões Pendentes" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EmissaoEmissoesPendentes}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" />
                            <TextBlock Text="aguardando emissão" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
