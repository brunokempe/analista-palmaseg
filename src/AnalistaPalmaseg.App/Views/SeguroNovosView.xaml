<UserControl x:Class="AnalistaPalmaseg.App.Views.SeguroNovosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             x:Name="Root"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Cabeçalho ── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldPlusOutline" Width="22" Height="22"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Seguros Novos" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                 Foreground="White"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,16,0"/>
                    <Button Command="{Binding NovoCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="White" Foreground="White" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Novo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Barra de filtros ── -->
        <materialDesign:Card Grid.Row="1" Margin="12,8,12,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"
                                      x:Name="ColProdutor"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Buscar por segurado, cia, segmento, status..."
                         Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13"/>

                <!-- Filtro por Produtor (admin only) -->
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ProdutoresDisponiveis}"
                          SelectedItem="{Binding FiltroProdutor}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Produtor"
                          Visibility="{Binding IsAdmin, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}"
                          Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="">
                                                <Setter Property="Text" Value="Todos"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2"
                        Command="{Binding LimparFiltrosCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Limpar filtros" Width="40" Padding="0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18"/>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- ── Corpo: lista + formulário ── -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Lista ── -->
            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                    Background="White" Margin="0,8,0,0">
                <DataGrid ItemsSource="{Binding RegistrosView}"
                          SelectedItem="{Binding RegistroSelecionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeRows="False"
                          RowHeight="34"
                          FontSize="12"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="Cia" Binding="{Binding Cia}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Vigência" Width="100">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Vigencia" StringFormat="dd/MM/yyyy"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="PL (R$)" Width="110">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Valor" StringFormat="C2"/>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,8,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- Coluna Produtor visível apenas para admin -->
                        <DataGridTemplateColumn Header="Produtor" Width="110"
                                                Visibility="{Binding DataContext.IsAdmin,
                                                             ElementName=Root,
                                                             Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CriadoPor}" VerticalAlignment="Center"
                                               FontSize="12" Margin="4,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Assinatura -->
                        <DataGridTemplateColumn Header="Assin." Width="60" CanUserSort="False">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Width="16" Height="16">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AssinaturaFeita}" Value="False">
                                                        <Setter Property="Kind" Value="CircleOutline"/>
                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Formulário ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <StackPanel Margin="24,20,24,24">

                    <!-- Linha 1: Vigência + Segurado -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vigência" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding EditandoVigencia}"
                                        materialDesign:HintAssist.Hint="dd/mm/aaaa"
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Segurado" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoSegurado, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Nome do segurado"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 2: Cia + Segmento -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cia / Seguradora" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True"
                                      Text="{Binding EditandoCia, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.Seguradoras}"
                                      materialDesign:HintAssist.Hint="Seguradora"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Segmento" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding EditandoSegmento}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.Segmentos}"
                                      materialDesign:HintAssist.Hint="Selecione"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 3: Status + Financeiro -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding EditandoStatus}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.StatusOpcoes}"
                                      materialDesign:HintAssist.Hint="Selecione"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Financeiro" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoFinanceiro, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Informação financeira"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 4: PL (R$) + Fator (%) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PL (R$)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoValor, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}"
                                     GotFocus="DecimalField_GotFocus"
                                     materialDesign:HintAssist.Hint="0,00"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fator (%)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoFator, StringFormat={}{0:N2}, UpdateSourceTrigger=LostFocus}"
                                     GotFocus="DecimalField_GotFocus"
                                     materialDesign:HintAssist.Hint="0,00"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 5: Forma de Pagamento + Parcelas -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Forma de Pagamento" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True"
                                      Text="{Binding EditandoFormaPagamento, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.FormasPagamento}"
                                      materialDesign:HintAssist.Hint="Selecione"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Parcelas" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding EditandoParcelas}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.Parcelamentos}"
                                      materialDesign:HintAssist.Hint="Nº de parcelas"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 6: Assinatura -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                        <TextBlock Text="Assinatura feita" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ToggleButton IsChecked="{Binding EditandoAssinaturaFeita}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Linha 7: Observação -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="Observação" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditandoObservacao, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Anotações adicionais..."
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Botões de anexo (apenas para registro salvo) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding TemRegistroSelecionado, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,0,16">
                        <Button Command="{Binding AnexarArquivosCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="30" Padding="10,0" FontSize="12" Margin="0,0,8,0"
                                ToolTip="Anexar arquivos a este registro">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PaperclipPlus" Width="13" Height="13"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Anexar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AbrirPastaAnexosCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="30" Padding="10,0" FontSize="12"
                                ToolTip="Abrir pasta de anexos">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="13" Height="13"
                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Pasta de anexos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Botões de ação -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ExcluirCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding SalvarCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Height="36" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
