<UserControl x:Class="AnalistaPalmaseg.App.Views.SeguroNovosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Cabeçalho ── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldPlusOutline" Width="22" Height="22"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Seguros Novos" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                 Foreground="White"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,16,0"/>
                    <Button Command="{Binding NovoCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="White" Foreground="White" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Novo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Corpo: lista + formulário ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Lista ── -->
            <Border Grid.Column="0" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0"
                    Background="White">
                <DataGrid ItemsSource="{Binding Registros}"
                          SelectedItem="{Binding RegistroSelecionado}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          CanUserResizeRows="False"
                          RowHeight="34"
                          FontSize="12"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}" Width="*" MinWidth="100"/>
                        <DataGridTextColumn Header="Cia" Binding="{Binding Cia}" Width="90"/>
                        <DataGridTextColumn Header="Segmento" Binding="{Binding Segmento}" Width="90"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Vigência" Width="80">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Vigencia" StringFormat="dd/MM/yy"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Valor" Width="80">
                            <DataGridTextColumn.Binding>
                                <Binding Path="Valor" StringFormat="C2"/>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Formulário ── -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24">

                    <!-- Linha 1: Vigência + Segurado -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Vigência" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding EditandoVigencia}"
                                        materialDesign:HintAssist.Hint="dd/mm/aaaa"
                                        Style="{StaticResource MaterialDesignDatePicker}"
                                        FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Segurado" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoSegurado, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Nome do segurado"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 2: Cia + Segmento -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Cia / Seguradora" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True"
                                      Text="{Binding EditandoCia, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.Seguradoras}"
                                      materialDesign:HintAssist.Hint="Seguradora"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Segmento" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding EditandoSegmento}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.Segmentos}"
                                      materialDesign:HintAssist.Hint="Selecione"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 3: Status + Financeiro -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox SelectedValue="{Binding EditandoStatus}"
                                      ItemsSource="{x:Static vm:SeguroNovosViewModel.StatusOpcoes}"
                                      materialDesign:HintAssist.Hint="Selecione"
                                      Style="{StaticResource MaterialDesignComboBox}"
                                      FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Financeiro" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoFinanceiro, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Informação financeira"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 4: PL + Fator + Valor -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PL (R$)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoPl, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="0,00"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fator (R$)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoFator, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="0,00"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Valor (R$)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditandoValor, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="0,00"
                                     Style="{StaticResource MaterialDesignTextBox}"
                                     FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Linha 5: Observação -->
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="Observação" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EditandoObservacao, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Anotações adicionais..."
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 FontSize="13"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Botões de ação -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ExcluirCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding SalvarCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Height="36" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
