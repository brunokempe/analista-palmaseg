<Window x:Class="AnalistaPalmaseg.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="PalmaSeg Analista" Height="700" Width="1100" MinHeight="600" MinWidth="900"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Padding="20,20,20,16"
                        BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="PalmaSeg" FontSize="18" FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="Analista de Carteira" FontSize="11"
                                   Foreground="{StaticResource SidebarTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Import Button -->
                <Border DockPanel.Dock="Bottom" Padding="12,12">
                    <Button Command="{Binding ImportarArquivoCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#2563EB" BorderBrush="#2563EB"
                            Foreground="White" HorizontalAlignment="Stretch"
                            Height="38" FontSize="13">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="Upload" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Importar ODS" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,8,0,0">
                    <TextBlock Text="PRINCIPAL" FontSize="10" FontWeight="SemiBold"
                               Foreground="#475569" Margin="20,8,0,4" />

                    <Button Command="{Binding NavDashboardCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Foreground="{StaticResource SidebarTextBrush}" Padding="20,10"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Dashboard" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavRenovacoesCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Foreground="{StaticResource SidebarTextBrush}" Padding="20,10"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Autorenew" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Renovações" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavNovosNegociosCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Foreground="{StaticResource SidebarTextBrush}" Padding="20,10"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="StarOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Novos negócios" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavPendentesCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Foreground="{StaticResource SidebarTextBrush}" Padding="20,10"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Pendentes" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="RELATÓRIOS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#475569" Margin="20,16,0,4" />

                    <Button Command="{Binding NavRetencaoCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Foreground="{StaticResource SidebarTextBrush}" Padding="20,10"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Evolução retenção" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    Padding="24,0">
                <DockPanel>
                    <TextBlock Text="{Binding TituloAtivo}" FontSize="16" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="#0F172A" />
                    <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Width="120" Height="4" VerticalAlignment="Center"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}" />
                </DockPanel>
            </Border>

            <!-- Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="0" />
        </Grid>
    </Grid>
</Window>
