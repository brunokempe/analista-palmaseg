<UserControl x:Class="AnalistaPalmaseg.App.Views.LeadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI"
             x:Name="Root">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Cabeçalho ── -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountConvertOutline" Width="22" Height="22"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Leeds — Cotações" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                                 Foreground="White"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,0,16,0"/>
                    <Button Command="{Binding NovoCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="White" Foreground="White" Height="34" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Novo" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Corpo: lista + formulário ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Lista ── -->
            <Grid Grid.Column="0" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="8">
                    <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Buscar..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="12"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding LeadsView}"
                         SelectedItem="{Binding LeadSelecionado}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Segurado + badge status -->
                                <DockPanel Grid.Row="0">
                                    <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,1"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Fechou}" Value="True">
                                                        <Setter Property="Background" Value="#E5E7EB"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="Aberto"/>
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Fechou}" Value="True">
                                                            <Setter Property="Text"       Value="Fechado"/>
                                                            <Setter Property="Foreground" Value="#6B7280"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="{Binding Segurado}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Produtor + data/hora -->
                                <TextBlock Grid.Row="1" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                    <Run Text="{Binding Produtor}"/>
                                    <Run Text=" • "/>
                                    <Run Text="{Binding CriadoEm, StringFormat='dd/MM/yyyy HH:mm'}"/>
                                </TextBlock>

                                <!-- Indicação -->
                                <TextBlock Grid.Row="2" Text="{Binding Indicacao}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Divisor -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="#E5E7EB" ResizeBehavior="PreviousAndNext"/>

            <!-- ── Formulário ── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,24">

                    <!-- ── Identificação ── -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="IDENTIFICAÇÃO" Style="{StaticResource SectionTitle}"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Segurado / Prospect" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditandoSegurado, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Nome do segurado ou empresa"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Produtor" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditandoProdutor, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Produtor responsável"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Text="Data e Hora" Style="{StaticResource FieldLabel}"/>
                                <DatePicker SelectedDate="{Binding EditandoCriadoEm}"
                                            Style="{StaticResource MaterialDesignDatePicker}"
                                            materialDesign:HintAssist.Hint="dd/mm/aaaa"
                                            FontSize="13" MaxWidth="200" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ── Lead ── -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="LEAD" Style="{StaticResource SectionTitle}"/>

                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="De onde veio a indicação" Style="{StaticResource FieldLabel}"/>
                                <ComboBox IsEditable="True"
                                          Text="{Binding EditandoIndicacao, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{x:Static vm:LeadsViewModel.FontesIndicacao}"
                                          materialDesign:HintAssist.Hint="Selecione ou digite"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="13"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Seguro gerado?" Style="{StaticResource FieldLabel}"/>
                                    <ToggleButton IsChecked="{Binding EditandoSeguroGerado}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fechou?" Style="{StaticResource FieldLabel}"/>
                                    <ToggleButton IsChecked="{Binding EditandoFechou}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Confirmação de Seguro Novo criado -->
                            <Border Margin="0,14,0,0" Background="#F0FDF4" CornerRadius="6" Padding="10,8"
                                    Visibility="{Binding TemSeguroNovoCriado, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                             Foreground="#065F46" VerticalAlignment="Center"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock FontSize="12" Foreground="#065F46" VerticalAlignment="Center">
                                        <Run Text="Seguro Novo criado — ID #"/>
                                        <Run Text="{Binding EditandoSeguroNovoId, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ── Observação ── -->
                    <materialDesign:Card Padding="16" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="OBSERVAÇÃO" Style="{StaticResource SectionTitle}"/>
                            <TextBox Text="{Binding EditandoObservacao, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Anotações sobre a cotação..."
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="90"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="13"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ── Botões ── -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding ExcluirCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="{StaticResource DangerBrush}"
                                Foreground="{StaticResource DangerBrush}"
                                Visibility="{Binding TemLeadSelecionado, Converter={StaticResource BoolToVisibilityConverter}}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Excluir" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelarCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Height="36" Padding="16,0" Margin="0,0,8,0">
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </Button>

                        <Button Command="{Binding SalvarCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Height="36" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
