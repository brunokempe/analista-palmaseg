<UserControl x:Class="AnalistaPalmaseg.App.Views.RelatorioEmissaoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels">

    <DockPanel>

        <!-- ── Cabeçalho ── -->
        <Border DockPanel.Dock="Top" Height="56"
                Background="{StaticResource PrimaryBrush}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Filtro ano -->
                    <TextBlock Text="Ano:" Foreground="White" VerticalAlignment="Center"
                               FontSize="13" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding AnosDisponiveis}"
                              SelectedItem="{Binding AnoSelecionado}"
                              Width="80" Foreground="White"
                              Margin="0,0,16,0"/>

                    <!-- Filtro produtor -->
                    <TextBox Width="200"
                             materialDesign:HintAssist.Hint="Filtrar produtor…"
                             materialDesign:HintAssist.Foreground="White"
                             Text="{Binding FiltroProdutor, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="White"
                             materialDesign:TextFieldAssist.UnderlineBrush="White"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RecarregarCommand}"
                        Style="{StaticResource MaterialDesignIconForegroundButton}"
                        Foreground="White" ToolTip="Recarregar">
                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Grid de dados ── -->
        <DataGrid ItemsSource="{Binding Linhas}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  materialDesign:DataGridAssist.CellPadding="10 6"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="10 6"
                  FontSize="13"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#F3F4F6"
                  BorderThickness="0"
                  RowBackground="White"
                  AlternatingRowBackground="#F9FAFB">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Produtor"
                                    Binding="{Binding Produtor}"
                                    Width="200" />
                <DataGridTextColumn Header="Mês"
                                    Binding="{Binding MesAno}"
                                    Width="80" />
                <DataGridTextColumn Header="Renovações"
                                    Binding="{Binding Renovacoes}"
                                    Width="100"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                <DataGridTextColumn Header="Seguros Novos"
                                    Binding="{Binding SegurosNovos}"
                                    Width="120"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding Total}"
                                    Width="80"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                <DataGridTextColumn Header="Prêmio / Valor"
                                    Binding="{Binding Valor, StringFormat=C2}"
                                    Width="140"
                                    ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
