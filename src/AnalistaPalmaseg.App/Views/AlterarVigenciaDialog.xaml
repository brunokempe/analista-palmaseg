<Window x:Class="AnalistaPalmaseg.App.Views.AlterarVigenciaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Alterar vigência" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">
    <StackPanel Margin="24">
        <TextBlock x:Name="PromptText" FontSize="13" Margin="0,0,0,16"
                   TextWrapping="Wrap" />

        <DatePicker x:Name="VigenciaInicialPicker"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    materialDesign:HintAssist.Hint="Vigência inicial"
                    FontSize="13" Margin="0,0,0,16" />

        <DatePicker x:Name="VigenciaFinalPicker"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                    materialDesign:HintAssist.Hint="Vigência final *"
                    FontSize="13" />

        <TextBlock x:Name="ErroText" Text="Informe a vigência final."
                   Foreground="Red" FontSize="11" Margin="4,4,0,0"
                   Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Height="36" Padding="20,0"
                    Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Confirmar" IsDefault="True"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="36" Padding="20,0"
                    Click="OK_Click" />
        </StackPanel>
    </StackPanel>
</Window>
