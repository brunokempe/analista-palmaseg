<Window x:Class="AnalistaPalmaseg.App.Views.AtualizarSeguroNovoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Atualizar informações — Seguro Novo"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel>

        <!-- Header -->
        <Border Background="#1565C0" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="ShieldPlusOutline" Width="20" Height="20"
                                             Foreground="White" VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Atualizar informações — Seguro Novo"
                               FontSize="15" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="SeguradoText" FontSize="12" Foreground="#BBDEFB" />
            </StackPanel>
        </Border>

        <!-- Formulário -->
        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,0">

                <!-- Produtor -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Produtor" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ProdutorCombo"
                              IsEditable="True"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46" FontSize="13" />
                </StackPanel>

                <!-- Vigência + Segurado -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vigência" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="VigenciaPicker"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Height="46" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Segurado" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SeguradoTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Seguradora (Cia) + Segmento -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Seguradora (Cia) *" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CiaCombo"
                                  IsEditable="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="46" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Segmento" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SegmentoCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="46" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Status + Financeiro -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StatusCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="46" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Financeiro" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FinanceiroTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- PL (R$) + Fator (%) -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PL (R$)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ValorTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fator (%)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FatorTextBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Forma de Pagamento + Parcelas -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Forma de Pagamento" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="FormaPagamentoCombo"
                                  IsEditable="True"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="46" FontSize="13" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Parcelas" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ParcelasCombo"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="46" FontSize="13" />
                    </StackPanel>
                </Grid>

                <!-- Assinatura feita -->
                <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                        Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Assinatura feita" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ToggleButton x:Name="AssinaturaToggle"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Observação -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Observação" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ObservacaoTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             Height="70" FontSize="13" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Botões -->
        <Border Padding="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,8,0" Click="Cancelar_Click" />
                <Button Content="Confirmar" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Confirmar_Click" />
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
