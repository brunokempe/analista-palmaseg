<UserControl x:Class="AnalistaPalmaseg.App.Views.EmissaoDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AnalistaPalmaseg.App.Converters"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Grid Panel.ZIndex="10"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Rectangle Fill="#80000000"/>
            <ProgressBar IsIndeterminate="True" Style="{StaticResource MaterialDesignCircularProgressBar}"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <DockPanel>

            <!-- ── Cabeçalho ── -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileCheckOutline" Width="26" Height="26"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dashboard de Emissão" FontSize="18" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="Acompanhamento das renovações Ren. Palma"
                                       FontSize="12" Foreground="#CCFFFFFF"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RecarregarCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="White" ToolTip="Recarregar dados">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Seletor de período + filtro por colaborador ── -->
            <Border DockPanel.Dock="Top" Background="White" Padding="16,8"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Período:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ComboBox ItemsSource="{Binding Meses}"
                                  SelectedItem="{Binding AtualMes}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Mês" Width="140" FontSize="13" Margin="0,0,8,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource MesFormatConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding Anos}"
                                  SelectedItem="{Binding AtualAno}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Ano" Width="90" FontSize="13" Margin="0,0,12,0"/>
                        <Button Content="CARREGAR"
                                Command="{Binding CarregarPorPeriodoCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Height="34" FontSize="12"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Colaborador:" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding ProdutoresDisponiveis}"
                                  SelectedItem="{Binding FiltroProdutor}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Todos"
                                  Width="180" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="">
                                                        <Setter Property="Text" Value="Todos"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Conteúdo principal (rolável) ── -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,14">

                <!-- ── Cards de resumo ── -->
                <UniformGrid Rows="1" Margin="0,0,0,14">

                    <Border Margin="0,0,8,0" Background="White" CornerRadius="8" Padding="20,16"
                            Effect="{StaticResource MaterialDesignShadowDepth1}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileSign" Width="20" Height="20"
                                                         Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Total Contratos" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalRenPalma}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="contratos fechados" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Background="White" CornerRadius="8" Padding="20,16"
                            Effect="{StaticResource MaterialDesignShadowDepth1}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyBrl" Width="20" Height="20"
                                                         Foreground="{StaticResource SuccessBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Prêmio Líquido Total" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PremioTotal, StringFormat=C2}" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="soma dos fechamentos" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Background="White" CornerRadius="8" Padding="20,16"
                            Effect="{StaticResource MaterialDesignShadowDepth1}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyBrl" Width="20" Height="20"
                                                         Foreground="#8B5CF6" Margin="0,0,8,0"/>
                                <TextBlock Text="Comissão Total" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ComissaoTotal, StringFormat=C2}" FontSize="22" FontWeight="Bold"
                                       Foreground="#8B5CF6" Margin="0,4,0,0"/>
                            <TextBlock Text="soma das comissões" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0" Background="White" CornerRadius="8" Padding="20,16"
                            Effect="{StaticResource MaterialDesignShadowDepth1}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileEditOutline" Width="20" Height="20"
                                                         Foreground="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Assinaturas Pendentes" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AssinaturasPendentes}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="aguardando assinatura" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="8,0,0,0" Background="White" CornerRadius="8" Padding="20,16"
                            Effect="{StaticResource MaterialDesignShadowDepth1}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ShieldOff" Width="20" Height="20"
                                                         Foreground="{StaticResource DangerBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Emissões Pendentes" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding EmissoesPendentes}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="aguardando emissão" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ── Por Produtor ── -->
                <Border Margin="0,0,0,14" Background="White" CornerRadius="8"
                        Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBlueBrush}"
                                CornerRadius="8,8,0,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="16" Height="16"
                                                         Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Por Produtor" FontSize="12" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <DataGrid ItemsSource="{Binding ResumoProdutor}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" CanUserResizeColumns="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  RowStyle="{StaticResource MaterialDesignDataGridRow}"
                                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                                  FontSize="13" RowHeight="36"
                                  MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produtor" Binding="{Binding Produtor}" Width="*" SortMemberPath="Produtor">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Total}" Width="75" SortMemberPath="Total">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Assinaturas" Binding="{Binding AssinaturaOk}" Width="95" SortMemberPath="AssinaturaOk">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Emitidos" Binding="{Binding EmitidoOk}" Width="85" SortMemberPath="EmitidoOk">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Progresso" Width="85" SortMemberPath="EmitidoOk">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Progresso}" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pendentes}" Value="0">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Prêmio" Binding="{Binding PremioTotal, StringFormat=C2}" Width="110" SortMemberPath="PremioTotal">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ── Contratos Ren. Palma ── -->
                <Border Background="White" CornerRadius="8" Margin="0,0,0,14"
                        Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" CornerRadius="8,8,0,0"
                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableLarge" Width="18" Height="18"
                                                         Foreground="{StaticResource AccentBlueBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Contratos Ren. Palma" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <DataGrid ItemsSource="{Binding Registros}"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  RowStyle="{StaticResource MaterialDesignDataGridRow}"
                                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                                  FontSize="13" RowHeight="36"
                                  MaxHeight="340"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Cliente" Binding="{Binding NomeCliente}"
                                                    Width="*" MinWidth="140" SortMemberPath="NomeCliente">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Vigência Final"
                                                    Binding="{Binding VigenciaFinal, StringFormat=dd/MM/yyyy}"
                                                    Width="115" SortMemberPath="VigenciaFinal">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Produtor" Binding="{Binding NovoProdutor}"
                                                    Width="120" SortMemberPath="NovoProdutor">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Seguradora" Binding="{Binding FechamentoSeguradora}"
                                                    Width="150" SortMemberPath="FechamentoSeguradora">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Prêmio Líq."
                                                    Binding="{Binding FechamentoPremioLiquido, StringFormat=C2}"
                                                    Width="115" SortMemberPath="FechamentoPremioLiquido">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="% Comissão"
                                                    Binding="{Binding FechamentoComissao, StringFormat={}{0:N2}%}"
                                                    Width="100" SortMemberPath="FechamentoComissao">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Comissão"
                                                    Binding="{Binding ComissaoValor, StringFormat=C2}"
                                                    Width="110" SortMemberPath="ComissaoValor">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Forma Pgto" Binding="{Binding FechamentoFormaPagamento}"
                                                    Width="120" SortMemberPath="FechamentoFormaPagamento">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Parcelas" Binding="{Binding FechamentoParcelamento}"
                                                    Width="90" SortMemberPath="FechamentoParcelamento">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Assinatura" Width="115" CanUserSort="False">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleAssinaturaCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="28" Padding="4,0"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="Clique para alternar">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14" Height="14"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="CheckCircle"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AssinaturaFeita}" Value="False">
                                                                        <Setter Property="Kind" Value="CloseCircle"/>
                                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock VerticalAlignment="Center" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Feita"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding AssinaturaFeita}" Value="False">
                                                                        <Setter Property="Text" Value="Pendente"/>
                                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Emitido" Width="100" CanUserSort="False">
                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.ToggleSeguroEmitidoCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Height="28" Padding="4,0"
                                                    HorizontalAlignment="Center"
                                                    ToolTip="Clique para alternar">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Width="14" Height="14"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,3,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="ShieldCheck"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SeguroEmitido}" Value="False">
                                                                        <Setter Property="Kind" Value="ShieldOff"/>
                                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                    <TextBlock VerticalAlignment="Center" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Sim"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SeguroEmitido}" Value="False">
                                                                        <Setter Property="Text" Value="Não"/>
                                                                        <Setter Property="Foreground" Value="#BDBDBD"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Emitido por" Binding="{Binding EmitidoPor}"
                                                    Width="115" SortMemberPath="EmitidoPor">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ── Seguros Novos ── -->
                <Border Background="White" CornerRadius="8"
                        Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <DockPanel>
                        <!-- Cabeçalho + filtros — mesmo padrão do Contratos Ren. Palma -->
                        <Border DockPanel.Dock="Top" CornerRadius="8,8,0,0"
                                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldPlusOutline" Width="18" Height="18"
                                                             Foreground="{StaticResource AccentBlueBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Seguros Novos" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Segurado:" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding FiltroSegNovSegurado, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Filtrar..."
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Width="150" FontSize="12" VerticalContentAlignment="Center"
                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Status:" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{x:Static vm:EmissaoDashboardViewModel.StatusSegNovoOpcoes}"
                                              SelectedItem="{Binding FiltroSegNovStatus}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Width="140" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Grid -->
                        <DataGrid ItemsSource="{Binding SeguroNovos}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  RowStyle="{StaticResource MaterialDesignDataGridRow}"
                                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                                  FontSize="13" RowHeight="36"
                                  MaxHeight="340"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}" Width="*" MinWidth="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cia" Binding="{Binding Cia}" Width="145">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Segmento" Binding="{Binding Segmento}" Width="125">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Vigência"
                                                    Binding="{Binding Vigencia, StringFormat=dd/MM/yyyy}"
                                                    Width="105">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Prêmio Líquido"
                                                    Binding="{Binding Valor, StringFormat=C2}"
                                                    Width="115">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,6,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="% Comissão"
                                                    Binding="{Binding Fator, StringFormat={}{0:N2}%}"
                                                    Width="100">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Comissão"
                                                    Binding="{Binding ComissaoValor, StringFormat=C2}"
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Margin" Value="0,0,8,0"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Cadastrado por" Binding="{Binding CriadoPor}" Width="145">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cadastrado em"
                                                    Binding="{Binding CriadoEm, StringFormat=dd/MM/yyyy}"
                                                    Width="115">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Observações" Binding="{Binding Observacao}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="4,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="ToolTip" Value="{Binding Observacao}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Grid>
</UserControl>
