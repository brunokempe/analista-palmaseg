<Window x:Class="AnalistaPalmaseg.App.Views.ClienteSelectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Selecionar cliente"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#757575" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1565C0" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AccountSearchOutline" Width="20" Height="20"
                                         Foreground="White" VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                <TextBlock Text="Selecionar cliente" FontSize="15" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ───────── Modo: pesquisa ───────── -->
        <Grid x:Name="PesquisaPanel" Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                    <TextBlock Text="Buscar por nome ou CPF" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FiltroBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13"
                             TextChanged="FiltroBox_TextChanged" />
                </StackPanel>

                <Button Grid.Column="2" x:Name="NovoClienteButton"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="40" Padding="14,0" VerticalAlignment="Bottom"
                        Click="NovoCliente_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlusOutline" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Novo cliente" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <DataGrid x:Name="ClientesGrid" Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      MouseDoubleClick="ClientesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="2*" />
                    <DataGridTextColumn Header="CPF" Binding="{Binding Cpf}" Width="140" />
                    <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone1}" Width="130" />
                    <DataGridTextColumn Header="Cidade" Binding="{Binding Cidade}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,8,0" Click="Cancelar_Click" />
                <Button Content="Selecionar" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Selecionar_Click" />
            </StackPanel>
        </Grid>

        <!-- ───────── Modo: novo cliente ───────── -->
        <Grid x:Name="NovoClientePanel" Grid.Row="1" Margin="20,16,20,16" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Nome *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NovoNomeBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CPF / CNPJ" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NovoCpfBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="13" MaxLength="18"
                                 TextChanged="NovoCpfBox_TextChanged" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Telefone" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NovoTelefoneBox"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 FontSize="13" MaxLength="15"
                                 TextChanged="NovoTelefoneBox_TextChanged" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="E-mail" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NovoEmailBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="13" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Observações" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NovoObservacoesBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="80" FontSize="13" />
                </StackPanel>

                <TextBlock x:Name="NovoErroText" Text="Informe o nome do cliente."
                           Foreground="Red" FontSize="11" Margin="2,0,0,0"
                           Visibility="Collapsed" />
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Voltar" Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,8,0" Click="VoltarPesquisa_Click" />
                <Button Content="Salvar e selecionar" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="SalvarNovoCliente_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
