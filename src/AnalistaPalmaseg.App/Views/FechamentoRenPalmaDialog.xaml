<Window x:Class="AnalistaPalmaseg.App.Views.FechamentoRenPalmaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Fechamento — Ren. Palma"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontFamily="{materialDesign:MaterialDesignFont}">

    <StackPanel>

        <!-- Header verde -->
        <Border Background="#2E7D32" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20"
                                             Foreground="White" VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="Fechamento — Ren. Palma"
                               FontSize="15" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ClienteText" FontSize="12" Foreground="#C8E6C9" />
            </StackPanel>
        </Border>

        <!-- Formulário -->
        <StackPanel Margin="20,16,20,0">

            <!-- Seguradora (linha 1) -->
            <ComboBox x:Name="SeguradoraCombo"
                      IsEditable="True"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Seguradora *"
                      Height="46" FontSize="13" Margin="0,0,0,12">
                <ComboBoxItem Content="Allianz" />
                <ComboBoxItem Content="Azul Seguros" />
                <ComboBoxItem Content="Bradesco Seguros" />
                <ComboBoxItem Content="Chubb" />
                <ComboBoxItem Content="Itaú Seguros" />
                <ComboBoxItem Content="Liberty" />
                <ComboBoxItem Content="Mapfre" />
                <ComboBoxItem Content="Porto Seguro" />
                <ComboBoxItem Content="Sompo" />
                <ComboBoxItem Content="SulAmérica" />
                <ComboBoxItem Content="Tokio Marine" />
                <ComboBoxItem Content="Zurich" />
            </ComboBox>

            <!-- Prêmio Líquido + Comissão (linha 2) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="PremioTextBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Prêmio Líquido (R$)"
                         Height="46" FontSize="13" />

                <TextBox Grid.Column="2"
                         x:Name="ComissaoTextBox"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Comissão (%)"
                         Height="46" FontSize="13" />
            </Grid>

            <!-- Forma de Pagamento + Parcelamento (linha 3) -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          x:Name="FormaPagamentoCombo"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Forma de Pagamento"
                          Height="46" FontSize="13">
                    <ComboBoxItem Content="Boleto" />
                    <ComboBoxItem Content="Cartão de Crédito" />
                    <ComboBoxItem Content="Débito em Conta" />
                    <ComboBoxItem Content="PIX" />
                    <ComboBoxItem Content="Débito Automático" />
                    <ComboBoxItem Content="Financiamento" />
                </ComboBox>

                <ComboBox Grid.Column="2"
                          x:Name="ParcelamentoCombo"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Parcelamento"
                          Height="46" FontSize="13">
                    <ComboBoxItem Content="1x" />
                    <ComboBoxItem Content="2x" />
                    <ComboBoxItem Content="3x" />
                    <ComboBoxItem Content="4x" />
                    <ComboBoxItem Content="5x" />
                    <ComboBoxItem Content="6x" />
                    <ComboBoxItem Content="7x" />
                    <ComboBoxItem Content="8x" />
                    <ComboBoxItem Content="9x" />
                    <ComboBoxItem Content="10x" />
                    <ComboBoxItem Content="11x" />
                    <ComboBoxItem Content="12x" />
                    <ComboBoxItem Content="24x" />
                    <ComboBoxItem Content="30x" />
                    <ComboBoxItem Content="36x" />
                </ComboBox>
            </Grid>

            <!-- Assinatura -->
            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                    Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Assinatura" FontSize="11" FontWeight="SemiBold"
                               Foreground="#9E9E9E" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkDigital" Content="Digital"
                                  FontSize="13" Margin="0,0,24,0" />
                        <CheckBox x:Name="ChkFisica" Content="Física"
                                  FontSize="13" Margin="0,0,24,0" />
                        <CheckBox x:Name="ChkOutros" Content="Outros"
                                  FontSize="13" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Seção de anexos -->
        <Border Margin="20,0,20,16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <StackPanel>

                <!-- Cabeçalho dos anexos -->
                <Border Background="#F5F5F5" Padding="14,8" CornerRadius="4,4,0,0"
                        BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Paperclip" Width="15" Height="15"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                 Foreground="#616161" />
                        <TextBlock x:Name="AnexosTitulo" Text="Cotações / Anexos"
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Lista de arquivos -->
                <ItemsControl x:Name="AnexosList">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="14,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontSize="12" />
                                        <TextBlock Text="{Binding Tamanho}" FontSize="10"
                                                   Foreground="#9E9E9E" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Tag="{Binding Caminho}"
                                            Click="AbrirAnexo_Click"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Height="28" Padding="8,0" FontSize="11"
                                            Content="Abrir" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Estado vazio -->
                <Border x:Name="SemAnexos" Padding="14,10" Visibility="Collapsed">
                    <TextBlock Text="Nenhum arquivo anexado a este registro."
                               FontSize="12" Foreground="#9E9E9E" FontStyle="Italic" />
                </Border>

            </StackPanel>
        </Border>

        <!-- Botões -->
        <Border Padding="20,0,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" IsCancel="True"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Margin="0,0,8,0" Click="Cancelar_Click" />
                <Button Content="Confirmar" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Confirmar_Click" />
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
