<UserControl x:Class="AnalistaPalmaseg.App.Views.ApolicesDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <DockPanel Margin="24,20,24,24">

        <!-- Info bar -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Text="{Binding InfoImportacao}" />
            </DockPanel>
        </Border>

        <!-- KPI Cards -->
        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,16">
            <materialDesign:Card Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Total de apólices" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding TotalApolices}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{StaticResource AccentBlueBrush}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Vencidas" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Vencidas}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="#EC3237" />
                    <TextBlock Text="pagamento em atraso" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,0,12,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Próximas (≤ 30 dias)" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Proximas}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="#FFCC29" />
                    <TextBlock Text="vencem em breve" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Em dia" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                    <TextBlock Text="{Binding EmDia}" FontSize="26" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Text="sem urgência" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Mensagem de estado vazio -->
        <Border DockPanel.Dock="Top" Padding="0,40,0,0"
                Visibility="{Binding SemDados, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="FileExcelOutline" Width="48" Height="48"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock Text="Nenhuma apólice importada" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="Nenhuma apólice cadastrada no sistema."
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           MaxWidth="400" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Tabelas agrupadas por status -->
        <ScrollViewer DockPanel.Dock="Bottom" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SemDados, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <StackPanel>

                <!-- Vencidas -->
                <materialDesign:Card Margin="0,0,0,16" Padding="0"
                    Visibility="{Binding ApolicesVencidas.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="#EC3237" CornerRadius="4,4,0,0" Padding="16,10">
                            <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold">
                                <Run Text="⚠ Vencidas — " />
                                <Run Text="{Binding Vencidas}" />
                                <Run Text=" apólices com pagamento em atraso" />
                            </TextBlock>
                        </Border>
                        <DataGrid ItemsSource="{Binding ApolicesVencidas}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segurado"   Binding="{Binding Segurado}"    Width="*" />
                                <DataGridTextColumn Header="Seguradora" Binding="{Binding Seguradora}"  Width="120" />
                                <DataGridTextColumn Header="Ramo"       Binding="{Binding Ramo}"        Width="110" />
                                <DataGridTextColumn Header="Apólice"    Binding="{Binding NumeroApolice}" Width="100" />
                                <DataGridTextColumn Header="Vencimento"
                                    Binding="{Binding DataVencimentoPagamento, StringFormat=dd/MM/yyyy}"
                                    Width="100" />
                                <DataGridTextColumn Header="Situação"   Binding="{Binding DiasLabel}"   Width="160" />
                                <DataGridTextColumn Header="Prêmio"
                                    Binding="{Binding Premio, Converter={StaticResource CurrencyFormatConverter}}"
                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Próximas ao vencimento -->
                <materialDesign:Card Margin="0,0,0,16" Padding="0"
                    Visibility="{Binding ApolicesProximas.Count, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Border Background="#FFCC29" CornerRadius="4,4,0,0" Padding="16,10">
                            <TextBlock Foreground="#1A1A1A" FontSize="13" FontWeight="SemiBold">
                                <Run Text="⏰ Próximas ao vencimento — " />
                                <Run Text="{Binding Proximas}" />
                                <Run Text=" apólices vencem nos próximos 30 dias" />
                            </TextBlock>
                        </Border>
                        <DataGrid ItemsSource="{Binding ApolicesProximas}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segurado"   Binding="{Binding Segurado}"    Width="*" />
                                <DataGridTextColumn Header="Seguradora" Binding="{Binding Seguradora}"  Width="120" />
                                <DataGridTextColumn Header="Ramo"       Binding="{Binding Ramo}"        Width="110" />
                                <DataGridTextColumn Header="Apólice"    Binding="{Binding NumeroApolice}" Width="100" />
                                <DataGridTextColumn Header="Vencimento"
                                    Binding="{Binding DataVencimentoPagamento, StringFormat=dd/MM/yyyy}"
                                    Width="100" />
                                <DataGridTextColumn Header="Situação"   Binding="{Binding DiasLabel}"   Width="160" />
                                <DataGridTextColumn Header="Prêmio"
                                    Binding="{Binding Premio, Converter={StaticResource CurrencyFormatConverter}}"
                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Todas as apólices -->
                <materialDesign:Card Padding="0">
                    <StackPanel>
                        <Border Background="{StaticResource SidebarBgBrush}" CornerRadius="4,4,0,0" Padding="16,10">
                            <TextBlock Foreground="White" FontSize="13" FontWeight="SemiBold">
                                <Run Text="Todas as apólices — " />
                                <Run Text="{Binding TotalApolices}" />
                                <Run Text=" registros" />
                            </TextBlock>
                        </Border>
                        <DataGrid ItemsSource="{Binding TodasApolices}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}" MaxHeight="320"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Segurado"   Binding="{Binding Segurado}"    Width="*" />
                                <DataGridTextColumn Header="Seguradora" Binding="{Binding Seguradora}"  Width="120" />
                                <DataGridTextColumn Header="Ramo"       Binding="{Binding Ramo}"        Width="110" />
                                <DataGridTextColumn Header="Apólice"    Binding="{Binding NumeroApolice}" Width="100" />
                                <DataGridTextColumn Header="Vencimento"
                                    Binding="{Binding DataVencimentoPagamento, StringFormat=dd/MM/yyyy}"
                                    Width="100" />
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusLabel, Converter={StaticResource ApoliceStatusColorConverter}}"
                                                    CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="White"
                                                           FontSize="11" FontWeight="Medium" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Situação"   Binding="{Binding DiasLabel}"   Width="160" />
                                <DataGridTextColumn Header="Prêmio"
                                    Binding="{Binding Premio, Converter={StaticResource CurrencyFormatConverter}}"
                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
