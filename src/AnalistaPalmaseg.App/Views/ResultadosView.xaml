<UserControl x:Class="AnalistaPalmaseg.App.Views.ResultadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <DockPanel Margin="24,20,24,24">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding Importacoes}"
                      SelectedItem="{Binding ImportacaoSelecionada}"
                      Width="220"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Período">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Importacao.Produtor, Mode=OneWay}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Importacao.Periodo, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <materialDesign:Card DockPanel.Dock="Bottom">
            <DockPanel>
            <Grid DockPanel.Dock="Bottom" Background="#F2F2F2" Margin="0" Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Total" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="1" Text="{Binding TotalMeta, Converter={StaticResource CurrencyFormatConverter}}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="{Binding TotalRealizado, Converter={StaticResource CurrencyFormatConverter}}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="3" Text="{Binding TotalSaldo, Converter={StaticResource CurrencyFormatConverter}}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                <TextBlock Grid.Column="4" Text="{Binding TotalPercentualAtingimento, Converter={StaticResource PercentFormatConverter}}"
                           FontWeight="Bold" VerticalAlignment="Center" Margin="12,0" />
                <Border Grid.Column="5" CornerRadius="3" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EC3237" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TotalBateuMeta}" Value="True">
                                    <Setter Property="Background" Value="#A7CF45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="11" FontWeight="Medium" Foreground="White">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="✗ Não bateu" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TotalBateuMeta}" Value="True">
                                        <Setter Property="Text" Value="✓ Bateu meta" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
            <DataGrid ItemsSource="{Binding Resultados}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Seguradora"
                        Binding="{Binding Funcionario}" Width="*" />
                    <DataGridTextColumn Header="Meta"
                        Binding="{Binding Meta, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="140" />
                    <DataGridTextColumn Header="Realizado"
                        Binding="{Binding Realizado, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="140" />
                    <DataGridTextColumn Header="Saldo"
                        Binding="{Binding Saldo, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="140" />
                    <DataGridTextColumn Header="% Atingimento"
                        Binding="{Binding PercentualAtingimento, Converter={StaticResource PercentFormatConverter}}"
                        Width="120" />
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="StatusBorder" CornerRadius="3" Padding="8,3"
                                        HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Medium"
                                               Foreground="White" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding BateuMeta}" Value="True">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#A7CF45" />
                                        <Setter TargetName="StatusText" Property="Text" Value="✓ Bateu meta" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding BateuMeta}" Value="False">
                                        <Setter TargetName="StatusBorder" Property="Background" Value="#EC3237" />
                                        <Setter TargetName="StatusText" Property="Text" Value="✗ Não bateu" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </materialDesign:Card>

    </DockPanel>
</UserControl>
