<UserControl x:Class="AnalistaPalmaseg.App.Views.GerenciadorRenovacoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AnalistaPalmaseg.App.Controls"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra de filtros -->
        <materialDesign:Card Grid.Row="0" Margin="16,12,16,0" Padding="16,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Margin="0,0,8,0"
                             materialDesign:HintAssist.Hint="Buscar cliente, proposta, apólice, placa..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             FontSize="12"
                             Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Command="{Binding LimparFiltrosCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            FontSize="12" Height="36" Padding="12,0"
                            ToolTip="Limpar filtros">
                        <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" />
                    </Button>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:MultiSelectFilterControl Grid.Column="0" Margin="0,0,8,0"
                        Hint="Status"
                        ItemsSource="{Binding StatusDisponiveis}"
                        SelectedItems="{Binding StatusSelecionados}" />

                    <controls:MultiSelectFilterControl Grid.Column="1" Margin="0,0,8,0"
                        Hint="Seguradora"
                        ItemsSource="{Binding SeguradorasDisponiveis}"
                        SelectedItems="{Binding SeguradorasSelecionadas}" />

                    <controls:MultiSelectFilterControl Grid.Column="2" Margin="0,0,8,0"
                        Hint="Ramo"
                        ItemsSource="{Binding RamosDisponiveis}"
                        SelectedItems="{Binding RamosSelecionados}" />

                    <controls:MultiSelectFilterControl Grid.Column="3" Margin="0,0,8,0"
                        Hint="Vendedor"
                        ItemsSource="{Binding VendedoresDisponiveis}"
                        SelectedItems="{Binding VendedoresSelecionados}" />

                    <controls:MultiSelectFilterControl Grid.Column="4"
                        Hint="Novo Produtor"
                        ItemsSource="{Binding ProdutoresDisponiveis}"
                        SelectedItems="{Binding ProdutoresSelecionados}" />
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- Abas por mês de vencimento -->
        <Border Grid.Row="1" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,1"
                Margin="16,6,16,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Hidden">
                <ListBox ItemsSource="{Binding MesesDisponiveis}"
                         SelectedItem="{Binding MesSelecionado}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,8" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="SnapsToDevicePixels" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource PrimaryBrush}"
                                                BorderThickness="0"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,3" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </ScrollViewer>
        </Border>

        <!-- Resumo -->
        <Border Grid.Row="2" Margin="16,6,16,0" Padding="12,6"
                Background="{StaticResource SidebarBgBrush}" CornerRadius="4">
            <TextBlock Text="{Binding Resumo}" FontSize="12"
                       Foreground="{StaticResource SidebarTextBrush}" />
        </Border>

        <!-- Atribuição em massa (aparece quando há registros marcados) -->
        <Border Grid.Row="3"
                Visibility="{Binding TemMarcados, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#E8F4FD" BorderBrush="#90CAF9" BorderThickness="0,1,0,1"
                Padding="16,6" Margin="16,0,16,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountMultiple" Width="16" Height="16"
                                         VerticalAlignment="Center" Foreground="#1565C0" Margin="0,0,8,0" />
                <TextBlock Text="Atribuir produtor aos marcados:"
                           VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="#1565C0" Margin="0,0,12,0" />
                <ComboBox Width="190"
                          ItemsSource="{Binding UsuariosDisponiveis}"
                          SelectedItem="{Binding NovoProdutorEmMassa}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Selecionar produtor"
                          VerticalAlignment="Center"
                          FontSize="12" Margin="0,0,8,0" />
                <Button Command="{Binding AtribuirEmMassaCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        VerticalAlignment="Center"
                        Height="36" Padding="14,0" FontSize="12"
                        Content="Atribuir" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="4"
                  x:Name="MainGrid"
                  Margin="16,8,16,0"
                  ItemsSource="{Binding RegistrosView}"
                  SelectedItem="{Binding RegistroSelecionado}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  AlternationCount="2"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  FontSize="12"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  ColumnHeaderStyle="{StaticResource MaterialDesignDataGridColumnHeader}"
                  RowEditEnding="MainGrid_RowEditEnding"
                  Sorting="MainGrid_Sorting"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  RowHeight="34">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Anexar arquivo(s)..."
                              Command="{Binding PlacementTarget.DataContext.AnexarArquivosCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13"/>
                    <MenuItem Header="Abrir pasta de anexos"
                              Command="{Binding PlacementTarget.DataContext.AbrirPastaAnexosCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13"/>
                    <Separator/>
                    <MenuItem Header="Gerar folha amarela"
                              Command="{Binding PlacementTarget.DataContext.GerarFolhaAmarelaCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13"/>
                    <Separator/>
                    <MenuItem Header="Marcar todos os visíveis"
                              Command="{Binding PlacementTarget.DataContext.MarcarTodosCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13"/>
                    <MenuItem Header="Desmarcar todos"
                              Command="{Binding PlacementTarget.DataContext.DesmarcarTodosCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13"/>
                    <Separator/>
                    <MenuItem Header="Gerar folhas amarelas marcadas..."
                              Command="{Binding PlacementTarget.DataContext.GerarFolhasMarcadasCommand,
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              FontSize="13" FontWeight="SemiBold"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
                    <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <ToolTip MaxWidth="480" Padding="0" FontFamily="Lato, Segoe UI">
                                <StackPanel>
                                    <!-- Cabeçalho: nome + CPF -->
                                    <Border Background="#2B2D36" Padding="12,8" CornerRadius="4,4,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding NomeCliente, TargetNullValue='Cliente não identificado'}"
                                                       FontWeight="SemiBold" FontSize="13" Foreground="White"/>
                                            <TextBlock Text="{Binding DocumentoPrincipal, StringFormat='CPF/CNPJ: {0}', TargetNullValue=''}"
                                                       FontSize="11" Foreground="#9DA3AE" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Observações -->
                                    <Border Padding="12,10" Background="White"
                                            Visibility="{Binding TemClienteObservacoes,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="OBSERVAÇÕES" FontSize="10" FontWeight="Bold"
                                                       Foreground="#EC3237" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ClienteObservacoes}"
                                                       FontSize="12" Foreground="#201D1D"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Separador entre seções -->
                                    <Border Height="1" Background="#E0E0E0"
                                            Visibility="{Binding TemClienteHistorico,
                                                         Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- Histórico -->
                                    <Border Padding="12,10" Background="White" CornerRadius="0,0,4,4"
                                            Visibility="{Binding TemClienteHistorico,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="HISTÓRICO" FontSize="10" FontWeight="Bold"
                                                       Foreground="#4E5399" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ClienteHistorico}"
                                                       FontSize="12" Foreground="#201D1D"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Placeholder quando não há nada cadastrado -->
                                    <Border Padding="12,10" Background="White" CornerRadius="0,0,4,4"
                                            Visibility="{Binding NaoTemInfoCliente,
                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Nenhuma observação ou histórico cadastrado para este cliente."
                                                   FontSize="12" Foreground="#9DA3AE" FontStyle="Italic"/>
                                    </Border>
                                </StackPanel>
                            </ToolTip>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9FAFB"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                            <Setter Property="Background" Value="#C8E6C9"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="#E3F2FD" Padding="10,5" Margin="0,3,0,0" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="#1565C0"
                                               Text="{Binding Items[0].NomeCliente, TargetNullValue='(sem nome)'}"/>
                                    <TextBlock FontSize="12" Foreground="#1565C0" Margin="8,0,0,0"
                                               Text="{Binding Name, StringFormat='— CPF: {0}', TargetNullValue='— CPF: (não informado)'}"/>
                                    <TextBlock FontSize="11" Foreground="#1976D2" Margin="8,0,0,0"
                                               Text="{Binding ItemCount, StringFormat='({0} apólice(s))'}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>

                <!-- Coluna de notas do cliente — ícone visual; conteúdo aparece no tooltip da linha -->
                <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserReorder="False" CanUserSort="False" Header="📋">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- vermelho = tem observação -->
                                <materialDesign:PackIcon Kind="NoteTextOutline" Width="16" Height="16" Foreground="#EC3237">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TemClienteObservacoes}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <!-- azul = tem histórico mas não tem observação -->
                                <materialDesign:PackIcon Kind="History" Width="16" Height="16" Foreground="#4E5399">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding TemClienteHistorico}"   Value="True"/>
                                                        <Condition Binding="{Binding TemClienteObservacoes}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Dia da Semana"
                                    Binding="{Binding DiaDaSemana}"                               Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vig. Fim"
                                    Binding="{Binding VigenciaFinal, StringFormat=dd/MM/yyyy}"    Width="115" IsReadOnly="True"/>

                <DataGridTemplateColumn Width="52" CanUserResize="False" CanUserReorder="False" CanUserSort="False">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="☑" FontSize="14" HorizontalAlignment="Center"
                                           Foreground="White" ToolTip="Use o menu de contexto para marcar/desmarcar todos"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="20" Height="20"
                                      Click="CheckBox_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Seguradora"    Binding="{Binding Seguradora}"         Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status"        Binding="{Binding Status}"             Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Ramo"          Binding="{Binding Ramo}"               Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Vendedor"      Binding="{Binding VendedorPrincipal}"  Width="160" IsReadOnly="True"/>

                <!-- Colunas editáveis (fundo amarelo) -->
                <DataGridTemplateColumn Header="Novo Produtor" Width="160" SortMemberPath="NovoProdutor">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="Background" Value="#FFF9C4"/>
                            <Setter Property="ToolTip" Value="Clique duas vezes para editar. Selecione &quot;Cancelado&quot; para seguros que não vão ser renovados — eles somem de Apólices &gt; Renovações."/>
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding NovoProdutor}" VerticalAlignment="Center"
                                       FontSize="12" Margin="4,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding NovoProdutor, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding DataContext.UsuariosDisponiveis,
                                                   RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      IsEditable="True"
                                      FontSize="12"
                                      VerticalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Observações do Cliente"
                                    Binding="{Binding ClienteObservacoes}"   Width="220" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ClienteObservacoes}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Prêmio Líquido"
                                    Binding="{Binding PremioLiquido, StringFormat=C2}"            Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="% Comissão"
                                    Binding="{Binding Comissao, StringFormat=N2}"                 Width="100" IsReadOnly="True"/>

                <DataGridTextColumn Header="Histórico do Cliente"
                                    Binding="{Binding ClienteHistorico}"     Width="220" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding ClienteHistorico}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="% Mín. Comissão"
                                    Binding="{Binding PercentualComissaoMinimo, UpdateSourceTrigger=LostFocus, StringFormat=N2, TargetNullValue=''}"
                                    Width="120">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="Background" Value="#FFF9C4"/>
                            <Setter Property="ToolTip" Value="Clique duas vezes para editar. Impede a renovação (Ren. Palma) se a comissão informada for menor que este percentual."/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Proposta"      Binding="{Binding Proposta}"          Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Apólice"       Binding="{Binding Apolice}"            Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cliente"       Binding="{Binding NomeCliente}"        Width="200" IsReadOnly="True"/>
                <DataGridTextColumn Header="CPF/CNPJ"      Binding="{Binding DocumentoPrincipal}" Width="130" IsReadOnly="True"/>

                <DataGridTextColumn Header="Observação"
                                    Binding="{Binding Observacao, UpdateSourceTrigger=LostFocus}"
                                    Width="220">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="Background" Value="#FFF9C4"/>
                            <Setter Property="ToolTip" Value="Clique duas vezes para editar (aparece na folha amarela)"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Parcelas"      Binding="{Binding NumeroParcelas}"     Width="70"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Forma Pagto"   Binding="{Binding FormaPagamento}"     Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Placa"         Binding="{Binding Placa}"              Width="80"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Modelo"        Binding="{Binding Modelo}"             Width="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="Cidade"        Binding="{Binding Cidade}"             Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="UF"            Binding="{Binding Estado}"             Width="50"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Vig. Início"
                                    Binding="{Binding VigenciaInicial, StringFormat=dd/MM/yyyy}"  Width="90"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Emissão"
                                    Binding="{Binding Emissao, StringFormat=dd/MM/yyyy}"          Width="90"  IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Grid Grid.Row="4" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80FFFFFF" />
            <ProgressBar IsIndeterminate="True" Width="200" Height="4" VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                         Foreground="{StaticResource PrimaryBrush}" />
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="5" Padding="16,4" Background="White"
                BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                <Run Text="Colunas em amarelo são editáveis — a edição é salva automaticamente. " />
                <Run Text="Use " />
                <Run Text="Importar relatório" FontWeight="SemiBold" />
                <Run Text=" na barra lateral para atualizar os dados da planilha." />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
