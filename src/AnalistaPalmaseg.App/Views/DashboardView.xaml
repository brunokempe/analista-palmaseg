<UserControl x:Class="AnalistaPalmaseg.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24">

            <!-- Period Selector -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Período:" VerticalAlignment="Center"
                           FontSize="13" Foreground="#64748B" Margin="0,0,12,0" />
                <ComboBox ItemsSource="{Binding Resumos}"
                          SelectedItem="{Binding ResumoSelecionado}"
                          Width="160"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Importacao.Produtor}" />
                                <Run Text=" — " />
                                <Run Text="{Binding Importacao.Periodo}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- KPI Cards -->
            <UniformGrid Columns="4" Margin="0,0,0,20">
                <!-- Retenção -->
                <materialDesign:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Retenção" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ResumoSelecionado.Retencao, Converter={StaticResource PercentFormatConverter}}"
                                   FontSize="28" FontWeight="Bold" Margin="0,4,0,0"
                                   Foreground="{Binding ResumoSelecionado.Retencao, Converter={StaticResource RetencaoColorConverter}}" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                            <Run Text="{Binding ResumoSelecionado.RenovadasPalma}" />
                            <Run Text=" de " />
                            <Run Text="{Binding ResumoSelecionado.TotalVencidas}" />
                            <Run Text=" renovadas" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- PL Base -->
                <materialDesign:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PL base (vencimentos)" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ResumoSelecionado.PlBase, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="#0F172A" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                            <Run Text="{Binding ResumoSelecionado.TotalVencidas}" />
                            <Run Text=" apólices vencidas" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Novos -->
                <materialDesign:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Novos negócios (PL)" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ResumoSelecionado.NovosPl, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="#0F172A" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                            <Run Text="{Binding ResumoSelecionado.NovosQtd}" />
                            <Run Text=" novos registros" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Participação -->
                <materialDesign:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Participação (comissão)" FontSize="12" Foreground="#64748B" />
                        <TextBlock Text="{Binding ResumoSelecionado.Participacao, Converter={StaticResource CurrencyFormatConverter}}"
                                   FontSize="20" FontWeight="Bold" Margin="0,4,0,0" Foreground="#0F172A" />
                        <TextBlock FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0">
                            <Run Text="{Binding ResumoSelecionado.NaoRenovado}" />
                            <Run Text=" não renovados" />
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Charts Row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pie chart - Status renovações -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Status das renovações" FontSize="13" FontWeight="Medium"
                                   Foreground="#0F172A" Margin="0,0,0,12" />
                        <lvc:PieChart Series="{Binding SeriesStatus}"
                                      Height="180" LegendPosition="Bottom"
                                      InitialRotation="-90" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Bar chart - Participação por seguradora -->
                <materialDesign:Card Grid.Column="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PL renovado por seguradora" FontSize="13" FontWeight="Medium"
                                   Foreground="#0F172A" Margin="0,0,0,12" />
                        <lvc:CartesianChart Series="{Binding SeriesParticipacao}"
                                            XAxes="{Binding AxesParticipacaoX}"
                                            Height="200" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Participação Table -->
            <materialDesign:Card Padding="16">
                <StackPanel>
                    <TextBlock Text="Participação detalhada por seguradora" FontSize="13" FontWeight="Medium"
                               Foreground="#0F172A" Margin="0,0,0,12" />
                    <DataGrid ItemsSource="{Binding Participacao}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seguradora" Binding="{Binding Cia}" Width="*" />
                            <DataGridTextColumn Header="PL renovado"
                                Binding="{Binding PlRenovado, Converter={StaticResource CurrencyFormatConverter}}"
                                Width="140" />
                            <DataGridTextColumn Header="Comissão"
                                Binding="{Binding Comissao, Converter={StaticResource CurrencyFormatConverter}}"
                                Width="120" />
                            <DataGridTextColumn Header="Part. %"
                                Binding="{Binding Percentual, Converter={StaticResource PercentFormatConverter}}"
                                Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
