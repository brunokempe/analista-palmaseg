<UserControl x:Class="AnalistaPalmaseg.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Background="{StaticResource PageBgBrush}"
             FontFamily="Lato, Segoe UI">

    <DockPanel Margin="24,20,24,24">

        <!-- Seletor de funcionário -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,20">
            <ComboBox ItemsSource="{Binding NomesDisponiveis}"
                      SelectedItem="{Binding NomeSelecionado}"
                      Width="280"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Funcionário"
                      HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Estado vazio -->
        <StackPanel DockPanel.Dock="Top" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="0,60,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Periodos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <materialDesign:PackIcon Kind="ChartTimeline" Width="48" Height="48"
                                     HorizontalAlignment="Center"
                                     Foreground="{StaticResource TextMutedBrush}" />
            <TextBlock Text="Nenhum dado encontrado"
                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="Importe uma planilha para ver os dados."
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Conteúdo principal: gráficos + timeline -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Periodos.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>

            <StackPanel>

                <!-- ── Período mais recente: KPI Cards ── -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <materialDesign:Card Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Retenção" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding ResumoAtual.Retencao, Converter={StaticResource PercentFormatConverter}}"
                                       FontSize="26" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{Binding ResumoAtual.Retencao, Converter={StaticResource RetencaoColorConverter}}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding ResumoAtual.RenovadasPalma}" />
                                <Run Text=" de " />
                                <Run Text="{Binding ResumoAtual.TotalVencidas}" />
                                <Run Text=" renovadas" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PL base (vencimentos)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding ResumoAtual.PlBase, Converter={StaticResource CurrencyFormatConverter}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding ResumoAtual.TotalVencidas}" />
                                <Run Text=" apólices vencidas" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Novos negócios (PL)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding ResumoAtual.NovosPl, Converter={StaticResource CurrencyFormatConverter}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource AccentBlueBrush}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding ResumoAtual.NovosQtd}" />
                                <Run Text=" novos registros" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Padding="16">
                        <StackPanel>
                            <TextBlock Text="Participação (comissão)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding ResumoAtual.Participacao, Converter={StaticResource CurrencyFormatConverter}}"
                                       FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                <Run Text="{Binding ResumoAtual.NaoRenovado}" />
                                <Run Text=" não renovados" />
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- ── Charts Row ── -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Status das renovações" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <lvc:PieChart Series="{Binding SeriesStatus}"
                                          Height="180" LegendPosition="Bottom"
                                          InitialRotation="-90" />
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="PL por seguradora (renovações + novos)" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                            <lvc:CartesianChart Series="{Binding SeriesParticipacao}"
                                                XAxes="{Binding AxesParticipacaoX}"
                                                Height="200" />
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>

                <!-- ── Participação detalhada ── -->
                <materialDesign:Card Padding="16" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="Participação detalhada por seguradora" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />
                        <DataGrid ItemsSource="{Binding Participacao}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource MaterialDesignDataGrid}"
                                  MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Seguradora" Binding="{Binding Cia}" Width="*" />
                                <DataGridTextColumn Header="PL renovado"
                                    Binding="{Binding PlRenovado, Converter={StaticResource CurrencyFormatConverter}}"
                                    Width="140" />
                                <DataGridTextColumn Header="Comissão"
                                    Binding="{Binding Comissao, Converter={StaticResource CurrencyFormatConverter}}"
                                    Width="120" />
                                <DataGridTextColumn Header="Part. %"
                                    Binding="{Binding Percentual, Converter={StaticResource PercentFormatConverter}}"
                                    Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Separador: histórico ── -->
                <TextBlock Text="HISTÓRICO — TODOS OS PERÍODOS"
                           FontSize="9.5" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,12" />

                <!-- ── Timeline de períodos ── -->
                <ItemsControl ItemsSource="{Binding Periodos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card Margin="0,0,0,12" UniformCornerRadius="10"
                                                 materialDesign:ElevationAssist.Elevation="Dp2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{StaticResource AccentBlueBrush}"
                                            Padding="20,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="PERÍODO" FontSize="9" FontWeight="Bold" Foreground="#BBFFFFFF" />
                                                <TextBlock Text="{Binding Importacao.Periodo}"
                                                           FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="RETENÇÃO" FontSize="9" FontWeight="Bold" Foreground="#BBFFFFFF" />
                                                <TextBlock Text="{Binding Retencao, Converter={StaticResource PercentFormatConverter}}"
                                                           Foreground="{Binding Retencao, Converter={StaticResource RetencaoColorConverter}}"
                                                           FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="PL BASE" FontSize="9" FontWeight="Bold" Foreground="#BBFFFFFF" />
                                                <TextBlock Text="{Binding PlBase, Converter={StaticResource CurrencyFormatConverter}}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="NOVOS PL" FontSize="9" FontWeight="Bold" Foreground="#BBFFFFFF" />
                                                <TextBlock Text="{Binding NovosPl, Converter={StaticResource CurrencyFormatConverter}}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="5" Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="PARTICIPAÇÃO" FontSize="9" FontWeight="Bold" Foreground="#BBFFFFFF" />
                                                <TextBlock Text="{Binding Participacao, Converter={StaticResource CurrencyFormatConverter}}"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="#FF69F0AE" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Grid.Row="1" Margin="20,10,20,12" Orientation="Horizontal">
                                        <TextBlock Margin="0,0,24,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="Vencidas:" FontWeight="SemiBold" />
                                            <Run Text="{Binding TotalVencidas}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,0,24,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="Renovadas:" FontWeight="SemiBold" />
                                            <Run Text="{Binding RenovadasPalma}" />
                                        </TextBlock>
                                        <TextBlock Margin="0,0,24,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="Pendentes:" FontWeight="SemiBold" />
                                            <Run Text="{Binding Pendentes}" />
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="12">
                                            <Run Text="Não renovados:" FontWeight="SemiBold" />
                                            <Run Text="{Binding NaoRenovado}" />
                                        </TextBlock>
                                    </WrapPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
