<UserControl x:Class="AnalistaPalmaseg.App.Views.PendentesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding Importacoes}"
                      SelectedItem="{Binding ImportacaoSelecionada}"
                      Width="200"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Período">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Importacao.Produtor}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Importacao.Periodo}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <materialDesign:Card DockPanel.Dock="Bottom">
            <DataGrid ItemsSource="{Binding Pendentes}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vigência" Binding="{Binding Vigencia}" Width="100" />
                    <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}" Width="*" />
                    <DataGridTextColumn Header="Seguradora" Binding="{Binding Cia}" Width="90" />
                    <DataGridTextColumn Header="Ramo" Binding="{Binding Ramo}" Width="120" />
                    <DataGridTextColumn Header="PL base"
                        Binding="{Binding PlBase, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="110" />
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White"
                                               FontSize="11" FontWeight="Medium" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

    </DockPanel>
</UserControl>
