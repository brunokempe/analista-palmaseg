<UserControl x:Class="AnalistaPalmaseg.App.Views.DefinicoesMetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             Background="{StaticResource PageBgBrush}">

    <UserControl.Resources>
        <Style x:Key="ColHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="ChartTimeline" Width="22" Height="22"
                                     Foreground="{StaticResource PrimaryBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="Definições de Metas" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
            <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                         Foreground="{StaticResource PrimaryBrush}"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryMid">

            <!-- ══ Tab 1: Seguradoras ══ -->
            <TabItem Header="Seguradoras">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Seletor de período -->
                    <materialDesign:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12" UniformCornerRadius="8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Período:" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox ItemsSource="{Binding Meses}"
                                      SelectedItem="{Binding SegMes}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Mês"
                                      Width="160" FontSize="13" Margin="0,0,8,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource MesFormatConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox ItemsSource="{Binding Anos}"
                                      SelectedItem="{Binding SegAno}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Ano"
                                      Width="100" FontSize="13"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Lista + Formulário -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <!-- Lista -->
                        <materialDesign:Card Grid.Column="0" Margin="0,0,12,0" Padding="0"
                                             UniformCornerRadius="8">
                            <DataGrid ItemsSource="{Binding Seguradoras}"
                                      SelectedItem="{Binding SeguradoraSelecionada}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                                      FontSize="13">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                                    <DataGridTemplateColumn Header="Parceira" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <materialDesign:PackIcon
                                                    Kind="{Binding IsParceira, Converter={StaticResource BoolToCheckKindConverter}}"
                                                    Width="16" Height="16"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsParceira}" Value="True">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Ativa" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <materialDesign:PackIcon
                                                    Kind="{Binding Ativo, Converter={StaticResource BoolToCheckKindConverter}}"
                                                    Width="16" Height="16"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Meta (R$)"
                                                        Binding="{Binding MetaPremio, StringFormat=N2}"
                                                        Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </materialDesign:Card>

                        <!-- Formulário -->
                        <materialDesign:Card Grid.Column="1" Padding="20" UniformCornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Seguradora" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                <TextBox Text="{Binding EditNome, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Nome da seguradora"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13" Margin="0,0,0,16"/>

                                <TextBox Text="{Binding EditMetaPremio, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Meta do mês (R$)"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13" Margin="0,0,0,16"/>

                                <CheckBox Content="Parceira" IsChecked="{Binding EditIsParceira}"
                                          Margin="0,0,0,12" FontSize="13"/>
                                <CheckBox Content="Ativa" IsChecked="{Binding EditAtivo}"
                                          Margin="0,0,0,20" FontSize="13"/>

                                <Button Content="SALVAR"
                                        Command="{Binding SalvarSeguradoraCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Foreground="White"
                                        Background="{StaticResource PrimaryBrush}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Content="NOVA"
                                        Command="{Binding NovaSeguradoraCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,0,8"/>

                                <Button Content="EXCLUIR"
                                        Command="{Binding ExcluirSeguradoraCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#EF4444"
                                        BorderBrush="#EF4444"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ══ Tab 2: Premiação ══ -->
            <TabItem Header="Premiação">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Premiação por seguradoras -->
                    <materialDesign:Card Grid.Row="0" Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Premiação por seguradoras atingidas" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Bônus concedido conforme a quantidade de seguradoras parceiras que atingirem a meta de prêmio."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <DataGrid ItemsSource="{Binding Premiacoes}"
                                      SelectedItem="{Binding PremiacaoSelecionada}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                                      FontSize="13" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Qtd. Mínima"
                                                        Binding="{Binding QuantidadeMinima}"
                                                        Width="*">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="Todas?"
                                                            Binding="{Binding EhTodas}"
                                                            Width="80"/>
                                    <DataGridTextColumn Header="Bônus (R$)"
                                                        Binding="{Binding ValorBonus, StringFormat=N2}"
                                                        Width="120">
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style TargetType="TextBox">
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="ADICIONAR REGRA"
                                        Command="{Binding AdicionarPremiacaoCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="12" Padding="12,4"
                                        Margin="0,0,8,0"/>
                                <Button Content="REMOVER SELECIONADA"
                                        Command="{Binding RemoverPremiacaoCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        FontSize="12" Padding="12,4"
                                        Foreground="#EF4444"
                                        BorderBrush="#EF4444"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Metas de crescimento -->
                    <materialDesign:Card Grid.Row="1" Padding="20" Margin="0,0,0,16" UniformCornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Metas de crescimento" FontSize="14"
                                       FontWeight="SemiBold" Margin="0,0,0,12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Bônus por crescimento do prêmio total (equipe) e da comissão total (individual) vs mesmo mês do ano anterior."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <DataGrid ItemsSource="{Binding Crescimentos}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      ColumnHeaderStyle="{StaticResource ColHeaderStyle}"
                                      FontSize="13" MaxHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Meta (%)"
                                                        Binding="{Binding PercentualMeta, StringFormat=P0}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="Bônus (R$)"
                                                        Binding="{Binding ValorBonus, StringFormat=N2}"
                                                        Width="120"/>
                                    <DataGridTemplateColumn Header="Nível" Width="*" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Individual"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EhEquipe}" Value="True">
                                                                    <Setter Property="Text" Value="Equipe (pago por fora)"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Botão salvar -->
                    <Button Grid.Row="2"
                            Content="SALVAR PREMIAÇÃO"
                            Command="{Binding SalvarPremiacaoCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            HorizontalAlignment="Right"
                            Width="200" Margin="0,0,0,16"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
