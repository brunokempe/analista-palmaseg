<UserControl x:Class="AnalistaPalmaseg.App.Views.NovosNegociosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F8FAFC">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Styles/Colors.xaml" />
                <ResourceDictionary Source="../Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,24">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox ItemsSource="{Binding Importacoes}"
                      SelectedItem="{Binding ImportacaoSelecionada}"
                      Width="200" Margin="0,0,12,0"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Período">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Importacao.Produtor}" />
                            <Run Text=" — " />
                            <Run Text="{Binding Importacao.Periodo}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" Margin="0,0,12,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Buscar segurado, cia, segmento..." />

            <ComboBox ItemsSource="{Binding StatusOpcoes}"
                      SelectedItem="{Binding FiltroStatus}"
                      Width="140"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      materialDesign:HintAssist.Hint="Status" />
        </StackPanel>

        <materialDesign:Card DockPanel.Dock="Bottom">
            <DataGrid ItemsSource="{Binding Negocios}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vigência" Binding="{Binding Vigencia}" Width="100" />
                    <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}" Width="*" />
                    <DataGridTextColumn Header="Seguradora" Binding="{Binding Cia}" Width="90" />
                    <DataGridTextColumn Header="Segmento" Binding="{Binding Segmento}" Width="130" />
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Status, Converter={StaticResource StatusColorConverter}}"
                                        CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" Foreground="White"
                                               FontSize="11" FontWeight="Medium" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="PL"
                        Binding="{Binding Pl, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="110" />
                    <DataGridTextColumn Header="Fator"
                        Binding="{Binding Fator, Converter={StaticResource PercentFormatConverter}}"
                        Width="70" />
                    <DataGridTextColumn Header="Comissão"
                        Binding="{Binding Comissao, Converter={StaticResource CurrencyFormatConverter}}"
                        Width="110" />
                    <DataGridTextColumn Header="Emitido por" Binding="{Binding EmitidoPor}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

    </DockPanel>
</UserControl>
