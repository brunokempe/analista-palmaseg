<UserControl x:Class="AnalistaPalmaseg.App.Views.ControleBoletosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AnalistaPalmaseg.App.ViewModels"
             x:Name="Root">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Converters.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Cabeçalho ── -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                Padding="16,0">
            <DockPanel>
                <materialDesign:PackIcon Kind="ReceiptTextCheckOutline"
                                         Width="22" Height="22" VerticalAlignment="Center"
                                         Foreground="White" Margin="0,0,10,0" />
                <TextBlock Text="Controle de Boletos"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Command="{Binding CarregarCommand}"
                        Style="{StaticResource MaterialDesignFlatLightButton}"
                        ToolTip="Recarregar" Padding="6" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" />
                </Button>
            </DockPanel>
        </Border>

        <!-- ── Barra de filtros ── -->
        <Border Grid.Row="1" Padding="12,8"
                BorderBrush="{DynamicResource MaterialDesign.Brush.DataGrid.RowHoverBackground}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                              IsChecked="{Binding ApenasPendentes}"
                              VerticalAlignment="Center" />
                <TextBlock Text="Mostrar apenas pendentes"
                           VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- ── Grid de boletos ── -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding ItensFiltrados}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  RowHeight="40"
                  materialDesign:DataGridAssist.CellPadding="4 4 4 4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8 6 8 6"
                  Margin="0">

            <DataGrid.Columns>

                <!-- Tipo -->
                <DataGridTemplateColumn Header="Tipo" Width="70" SortMemberPath="TipoLabel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1565C0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tipo}"
                                                         Value="{x:Static vm:TipoOrigem.SeguroNovo}">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding TipoLabel}"
                                           Foreground="White" FontSize="10"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Segurado -->
                <DataGridTextColumn Header="Segurado" Binding="{Binding Segurado}"
                                    Width="*" MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Seguradora abreviada -->
                <DataGridTemplateColumn Header="Seguradora" Width="85" SortMemberPath="Seguradora">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Seguradora, Converter={StaticResource SeguradoraAbrevConverter}}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       ToolTip="{Binding Seguradora}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Vigência -->
                <DataGridTextColumn Header="Vigência"
                                    Binding="{Binding Vigencia, StringFormat={}{0:dd/MM/yyyy}}"
                                    Width="95">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Produtor -->
                <DataGridTextColumn Header="Produtor" Binding="{Binding Produtor}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Boletos: - / X/Y / + -->
                <DataGridTemplateColumn Header="Boletos" Width="160" SortMemberPath="BoletosGerados">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button Width="26" Height="26" Padding="0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.DecrementarBoletoCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remover boleto gerado">
                                    <materialDesign:PackIcon Kind="Minus" Width="14" Height="14" />
                                </Button>
                                <TextBlock Text="{Binding Progresso}"
                                           Width="52" TextAlignment="Center"
                                           VerticalAlignment="Center" FontSize="13"
                                           FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Completo}" Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Width="26" Height="26" Padding="0"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Command="{Binding DataContext.IncrementarBoletoCommand,
                                                          RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Marcar boleto como gerado">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status -->
                <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="Completo">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="3" Padding="6,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E65100" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Completo}" Value="True">
                                                <Setter Property="Background" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="PENDENTE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Completo}" Value="True">
                                                    <Setter Property="Text" Value="COMPLETO" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80000000" />
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

    </Grid>
</UserControl>
