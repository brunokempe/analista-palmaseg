<UserControl x:Class="AnalistaPalmaseg.App.Views.SalvarPropostasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="Lato, Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,24" MaxWidth="860">

            <!-- Card: Diretórios configurados -->
            <materialDesign:Card Padding="20,18" Margin="0,0,0,16" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Diretórios de destino"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Cadastre uma ou mais pastas. Todo arquivo selecionado ou arrastado abaixo será copiado automaticamente para cada uma delas."
                               FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,14" />

                    <Button Command="{Binding AdicionarPastaCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            HorizontalAlignment="Left"
                            Height="44"
                            Padding="16,0"
                            Margin="0,0,0,14"
                            materialDesign:ButtonAssist.CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderPlusOutline"
                                                     Width="16" Height="16"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="Adicionar diretório" VerticalAlignment="Center" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <DataGrid ItemsSource="{Binding Pastas}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Style="{StaticResource MaterialDesignDataGrid}"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              MaxHeight="220">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Caminho"
                                                Binding="{Binding Caminho}"
                                                Width="*"
                                                ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                            <DataGridTemplateColumn Header="Ações" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoverPastaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource DangerBrush}"
                                                Padding="8,4" Height="32" FontSize="12"
                                                ToolTip="Remover diretório">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                                         VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBlock Text="Remover" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Feedback -->
            <Border Padding="12,8" CornerRadius="6" Margin="0,0,0,12"
                    Visibility="{Binding Mensagem, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SuccessLightBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMensagemErro}" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Mensagem}" FontSize="13" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMensagemErro}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <!-- Card: Área de arrastar/selecionar -->
            <materialDesign:Card Padding="0" UniformCornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Salvar proposta"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="20,16,20,12" />

                    <Border x:Name="DropZone"
                            Margin="20,0,20,20"
                            MinHeight="160"
                            BorderThickness="2"
                            BorderBrush="{StaticResource BorderLightBrush}"
                            Background="{StaticResource PageBgBrush}"
                            CornerRadius="8"
                            AllowDrop="True"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessando}" Value="True">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="TrayArrowUp"
                                                     Width="36" Height="36"
                                                     HorizontalAlignment="Center"
                                                     Foreground="{StaticResource TextMutedBrush}"
                                                     Margin="0,0,0,10" />
                            <TextBlock Text="Arraste o(s) arquivo(s) da proposta aqui"
                                       FontSize="13" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,10" />
                            <Button Command="{Binding SelecionarArquivosCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Center"
                                    Height="38" Padding="14,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileSearchOutline" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Selecionar arquivo(s)" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
