<UserControl x:Class="AnalistaPalmaseg.App.Views.DashboardMetasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource PageBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Cabeçalho + seletor de período + colaborador ────────────────── -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <TextBlock Text="Período:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding Meses}"
                          SelectedItem="{Binding AtualMes}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Mês" Width="140" FontSize="13" Margin="0,0,8,0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource MesFormatConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding Anos}"
                          SelectedItem="{Binding AtualAno}"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          materialDesign:HintAssist.Hint="Ano" Width="90" FontSize="13" Margin="0,0,20,0"/>

                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Width="1" Height="22" Background="#DDDDDD" VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <materialDesign:PackIcon Kind="AccountGroupOutline" Width="16" Height="16"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Colaborador:" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox ItemsSource="{Binding Colaboradores}"
                              SelectedItem="{Binding ColaboradorSelecionado}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Width="170" FontSize="13" Margin="0,0,12,0"/>
                </StackPanel>
                <Button Content="CARREGAR"
                        Command="{Binding CarregarCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Height="36" FontSize="12" Margin="0,0,16,0"/>

                <ProgressBar IsIndeterminate="True" Width="80" Height="3"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Foreground="{StaticResource PrimaryBrush}"/>
            </StackPanel>

            <!-- ── Conteúdo principal ─────────────────────────────────────────────── -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Seguradoras (full width) ──────────────────────────────────── -->
                <materialDesign:Card Grid.Row="0" Padding="20" UniformCornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <materialDesign:PackIcon Kind="OfficeBuildingOutline" Width="18" Height="18"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SEGURADORAS — ALCANCE DA META" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <Run Text="{Binding QtdSeguradorasAtingidas, Mode=OneWay}"/>
                                <Run Text="parceiras atingidas" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding SeguradorasAlcance}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  FontSize="13" Margin="0,12,0,0" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Seguradora" Binding="{Binding Nome}" Width="2*" MinWidth="140"/>
                                <DataGridTemplateColumn Header="Parceira" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsParceira, Converter={StaticResource BoolToSimNaoConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsParceira}" Value="True">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Meta (R$)"
                                                    Binding="{Binding Meta, StringFormat=N2}" Width="120"/>
                                <DataGridTextColumn Header="Realizado (R$)"
                                                    Binding="{Binding Realizado, StringFormat=N2}" Width="130"/>
                                <DataGridTemplateColumn Header="Saldo (R$)" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Saldo, StringFormat=N2}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="12" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SaldoPositivo}" Value="False">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Alcance"
                                                    Binding="{Binding PercentualFormatado}" Width="80"/>
                                <DataGridTextColumn Header="Participação (R$)"
                                                    Binding="{Binding Participacao, StringFormat=C2}" Width="130"/>
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Atingiu}" Value="False">
                                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="✓"/>
                                                            <Setter Property="Foreground" Value="#065F46"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Atingiu}" Value="False">
                                                                    <Setter Property="Text" Value="—"/>
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Linha de totais — colunas espelham o DataGrid + 17px do scrollbar fixo -->
                        <Border Background="#F0F4FF" CornerRadius="0,0,4,4" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="140"/><!-- Seguradora -->
                                    <ColumnDefinition Width="80"/>               <!-- Parceira -->
                                    <ColumnDefinition Width="120"/>              <!-- Meta -->
                                    <ColumnDefinition Width="130"/>              <!-- Realizado -->
                                    <ColumnDefinition Width="120"/>              <!-- Saldo -->
                                    <ColumnDefinition Width="80"/>               <!-- Alcance -->
                                    <ColumnDefinition Width="130"/>              <!-- Participação -->
                                    <ColumnDefinition Width="90"/>               <!-- Status -->
                                    <ColumnDefinition Width="17"/>               <!-- Scrollbar -->
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="TOTAL" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>

                                <StackPanel Grid.Column="2" Margin="6,0">
                                    <TextBlock Text="Meta" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalMeta, StringFormat=N2}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="6,0">
                                    <TextBlock Text="Realizado" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalRealizado, StringFormat=N2}" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="6,0">
                                    <TextBlock Text="Saldo" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalSaldo, StringFormat=N2}" FontSize="12" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TotalSaldoPositivo}" Value="False">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="6" Margin="6,0">
                                    <TextBlock Text="Participação" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TotalParticipacao, StringFormat=C2}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="#10B981"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ── Prêmio | Participação | Bônus ─────────────────────────────── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- PRÊMIO -->
                    <materialDesign:Card Grid.Column="0" Padding="20" UniformCornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="CurrencyBrl" Width="18" Height="18"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="R$ PRÊMIO" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Até o momento:" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding AtualPremio, StringFormat=C2}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>

                            <!-- Breakdown: Ren. Palma | Seguros Novos -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ren. Palma" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AtualPremioRenPalma, StringFormat=C2}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#E5E7EB" Margin="0,2"/>
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Seguros Novos" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AtualPremioSegNovos, StringFormat=C2}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Comissão gerada para a corretora -->
                            <Border Background="#F0FDF4" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Comissão da corretora"
                                               FontSize="11" Foreground="#065F46" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding AtualComissaoCorretora, StringFormat=C2}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#065F46"/>
                                </Grid>
                            </Border>

                            <!-- Ref. Prêmio + crescimento -->
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ref. Ano Anterior — Prêmio" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RefPremio, StringFormat=C2}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Text>
                                            <Binding Path="CrescimentoPremio" StringFormat="+{0:P1}"/>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PremioAtinge10}" Value="False">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Meta +10% -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Falta p/ +10%:  R$ "/>
                                    <Run Text="{Binding PremioMeta10, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PremioAtinge10}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ Atingido"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PremioAtinge10}" Value="False">
                                                        <Setter Property="Text" Value="Pendente"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Meta +15% Prêmio -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Falta p/ +15%:  R$ "/>
                                    <Run Text="{Binding PremioMeta15, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PremioAtinge15}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ Atingido"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PremioAtinge15}" Value="False">
                                                        <Setter Property="Text" Value="Pendente"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Divider + seção Comissão -->
                            <Border Height="1" Background="#E5E7EB" Margin="0,0,0,10"/>
                            <TextBlock Text="CRESCIMENTO COMISSÃO" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <!-- Ref. Comissão + crescimento -->
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ref. Ano Anterior — Comissão" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RefComissao, StringFormat=C2}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               Text="{Binding CrescimentoComissao, StringFormat=+{0:P1}}"
                                               FontSize="13" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComissaoAtinge15}" Value="False">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- Meta +15% Comissão -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Falta p/ +15%:  R$ "/>
                                    <Run Text="{Binding ComissaoMeta15, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ComissaoAtinge15}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ Atingido"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComissaoAtinge15}" Value="False">
                                                        <Setter Property="Text" Value="Pendente"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Meta +20% Comissão -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Falta p/ +20%:  R$ "/>
                                    <Run Text="{Binding ComissaoMeta20, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                </TextBlock>
                                <Border Grid.Column="1" CornerRadius="4" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ComissaoAtinge20}" Value="False">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="✓ Atingido"/>
                                                <Setter Property="Foreground" Value="#065F46"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ComissaoAtinge20}" Value="False">
                                                        <Setter Property="Text" Value="Pendente"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                        </StackPanel>
                    </materialDesign:Card>

                    <!-- PARTICIPAÇÃO -->
                    <materialDesign:Card Grid.Column="2" Padding="20" UniformCornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="AccountCash" Width="18" Height="18"
                                                         Foreground="#8B5CF6"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="R$ PARTICIPAÇÃO" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="Até o momento:" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding ComissaoColabTotal, StringFormat=C2}"
                                       FontSize="22" FontWeight="SemiBold"
                                       Foreground="#8B5CF6" Margin="0,0,0,14"/>

                            <!-- Ren. Palma -->
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="Renovações Palma"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ComissaoColabRenPalma, StringFormat=C2}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Seguros Novos -->
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="Seguros Novos"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ComissaoColabSegNovos, StringFormat=C2}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Total c/ bônus -->
                            <Border Background="#EDE9FE" CornerRadius="6" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL C/ BÔNUS" FontSize="11" FontWeight="Bold"
                                               Foreground="#5B21B6" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding TotalGeralColab, StringFormat=C2}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="#5B21B6" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- BÔNUS -->
                    <materialDesign:Card Grid.Column="4" Padding="20" UniformCornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="StarOutline" Width="18" Height="18"
                                                         Foreground="#F59E0B"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="BÔNUS ESTIMADO" FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Regras de premiação por seguradoras -->
                            <ItemsControl ItemsSource="{Binding PremiacaoItens}" Margin="0,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontSize="12" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Bonus}" Value="0">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Bonus, StringFormat=C2}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Bonus}" Value="0">
                                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Crescimento prêmio" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Falta p/ +10%: R$ "/>
                                            <Run Text="{Binding PremioMeta10, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Falta p/ +15%: R$ "/>
                                            <Run Text="{Binding PremioMeta15, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BonusCrescimentoPremio, StringFormat=C2}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#10B981" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Background="#F3F4F6" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Crescimento comissão" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Falta p/ +15%: R$ "/>
                                            <Run Text="{Binding ComissaoMeta15, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="Falta p/ +20%: R$ "/>
                                            <Run Text="{Binding ComissaoMeta20, Mode=OneWay, StringFormat={}{0:N2}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BonusCrescimentoComissao, StringFormat=C2}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="#10B981" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Background="#FEF3C7" CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TOTAL" FontSize="13" FontWeight="Bold"
                                               Foreground="#92400E" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BonusTotal, StringFormat=C2}"
                                               FontSize="18" FontWeight="Bold"
                                               Foreground="#92400E" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </Grid>

            <!-- ── Referência (ano anterior) — compacta ───────────────────────── -->
            <materialDesign:Card Grid.Row="2" Padding="14,10" UniformCornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="REFERÊNCIA ANO ANTERIOR" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1"/>

                    <TextBox Grid.Column="2"
                             Text="{Binding RefPremio, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Prêmio total (R$)"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             IsReadOnly="{Binding IsNotAdmin}"
                             FontSize="13"/>

                    <TextBox Grid.Column="4"
                             Text="{Binding RefComissao, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Comissão total (R$)"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             IsReadOnly="{Binding IsNotAdmin}"
                             FontSize="13"/>

                    <Button Grid.Column="6"
                            Content="SALVAR REFERÊNCIA"
                            Command="{Binding SalvarRefCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Height="40" FontSize="12" VerticalAlignment="Center"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:Card>

        </Grid>
    </ScrollViewer>
</UserControl>
