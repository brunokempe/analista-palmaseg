<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PrimaryColor">#1565C0</Color>
    <Color x:Key="PrimaryLightColor">#E3F2FD</Color>
    <Color x:Key="SuccessColor">#22c55e</Color>
    <Color x:Key="WarningColor">#f59e0b</Color>
    <Color x:Key="DangerColor">#ef4444</Color>
    <Color x:Key="SidebarBg">#1E293B</Color>
    <Color x:Key="SidebarText">#CBD5E1</Color>
    <Color x:Key="SidebarActiveText">#FFFFFF</Color>
    <Color x:Key="SidebarActiveBg">#2563EB</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarText}" />
    <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="{StaticResource SidebarActiveBg}" />
</ResourceDictionary>
