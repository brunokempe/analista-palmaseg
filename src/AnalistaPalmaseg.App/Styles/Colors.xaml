<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palma Brand Colors -->
    <Color x:Key="PrimaryColor">#EC3237</Color>
    <Color x:Key="PrimaryLightColor">#FDECED</Color>
    <Color x:Key="PrimaryDarkColor">#CB3337</Color>
    <Color x:Key="SecondaryColor">#FFCC29</Color>
    <Color x:Key="SecondaryLightColor">#FFF8DC</Color>
    <Color x:Key="AccentBlueColor">#4E5399</Color>
    <Color x:Key="AccentTealColor">#50A7B0</Color>

    <!-- Semantic colors using Palma palette -->
    <Color x:Key="SuccessColor">#A7CF45</Color>
    <Color x:Key="SuccessLightColor">#F0F8E0</Color>
    <Color x:Key="WarningColor">#FFCC29</Color>
    <Color x:Key="WarningLightColor">#FFF8DC</Color>
    <Color x:Key="DangerColor">#EC3237</Color>
    <Color x:Key="DangerLightColor">#FDECED</Color>

    <!-- Sidebar -->
    <Color x:Key="SidebarBg">#2B2D36</Color>
    <Color x:Key="SidebarBgDark">#20222A</Color>
    <Color x:Key="SidebarText">#9DA3AE</Color>
    <Color x:Key="SidebarActiveText">#FFFFFF</Color>
    <Color x:Key="SidebarActiveBg">#EC3237</Color>
    <Color x:Key="SidebarSection">#4A4A5A</Color>

    <!-- Content area -->
    <Color x:Key="PageBg">#F5F5F5</Color>
    <Color x:Key="CardBg">#FFFFFF</Color>
    <Color x:Key="BorderLight">#E0E0E0</Color>
    <Color x:Key="TextPrimary">#201D1D</Color>
    <Color x:Key="TextSecondary">#606061</Color>
    <Color x:Key="TextMuted">#9DA3AE</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush"    Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="SecondaryBrush"       Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush"      Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentTealBrush"      Color="{StaticResource AccentTealColor}" />
    <SolidColorBrush x:Key="SuccessBrush"         Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessLightBrush"    Color="{StaticResource SuccessLightColor}" />
    <SolidColorBrush x:Key="WarningBrush"         Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningLightBrush"    Color="{StaticResource WarningLightColor}" />
    <SolidColorBrush x:Key="DangerBrush"          Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerLightBrush"     Color="{StaticResource DangerLightColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush"       Color="{StaticResource SidebarBg}" />
    <SolidColorBrush x:Key="SidebarBgDarkBrush"   Color="{StaticResource SidebarBgDark}" />
    <SolidColorBrush x:Key="SidebarTextBrush"     Color="{StaticResource SidebarText}" />
    <SolidColorBrush x:Key="SidebarActiveBgBrush" Color="{StaticResource SidebarActiveBg}" />
    <SolidColorBrush x:Key="PageBgBrush"          Color="{StaticResource PageBg}" />
    <SolidColorBrush x:Key="BorderLightBrush"     Color="{StaticResource BorderLight}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondary}" />
    <SolidColorBrush x:Key="TextMutedBrush"       Color="{StaticResource TextMuted}" />

</ResourceDictionary>
